---
// One page per service: Nav, PageHeader, Sections, Statement, Footer.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ServiceRows from '../components/ServiceRows.astro';
import ClientList from '../components/ClientList.astro';
import Statement from '../components/Statement.astro';
import { contact, services, type Service } from '../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
---
<Base title={`${service.name} — Bansavage`} description={`${service.lead} ${service.leadMuted}`}>
  <PageHeader
    title={service.name}
    lead={service.lead}
    leadMuted={service.leadMuted}
    primary={{ label: 'Start a project', href: `mailto:${contact.email}` }}
    secondary={service.workHref ? { label: 'See the work', href: service.workHref } : undefined}
  />

  {service.sections.map((section) => (
    <Section title={section.title} id={section.id}>
      {section.rows && <ServiceRows rows={section.rows} />}
      {section.clients && <ClientList />}
    </Section>
  ))}

  <Statement />
</Base>
